<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <application android:name=".LauncherApp" android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:appCategory="game" android:theme="@style/CarbonTheme"
        android:allowBackup="false" android:extractNativeLibs="true"
        android:supportsRtl="false">
        <provider android:name=".UpdateProvider" android:authorities="pl.rexlauncher.updates" android:exported="false" android:grantUriPermissions="true" />
        <activity android:name=".CarbonActivity" android:exported="false"
            android:process=":carbon" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation|uiMode|screenLayout|smallestScreenSize"
            android:enableOnBackInvokedCallback="false" />
        <activity android:name=".GameActivity" android:exported="false"
            android:process=":game"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|navigation"
            android:enableOnBackInvokedCallback="false" />
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
